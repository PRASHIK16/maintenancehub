# =============================================================================
# MaintenanceHub — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://maintenancehub:password@localhost:5432/maintenancehub
POSTGRES_DB=maintenancehub
POSTGRES_USER=maintenancehub
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MaintenanceHub <noreply@maintenancehub.com>

# ─── File Storage ─────────────────────────────────────────────────────────────
# Development: local storage (default)
# Production: S3-compatible
STORAGE_BACKEND=local

# AWS / S3-compatible (set STORAGE_BACKEND=s3 in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# ─── AI (Optional) ────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── Application ──────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000
APP_NAME=MaintenanceHub
SUPPORT_EMAIL=support@maintenancehub.com

# ─── Security (Production) ────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
